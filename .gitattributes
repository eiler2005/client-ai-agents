# Переводы строк в репозитории всегда LF, независимо от core.autocrlf на машине:
# иначе хуки и собранные файлы различаются между разработчиками.
* text=auto eol=lf

# Сборочные артефакты и бинарные форматы не трогать.
*.pdf binary
*.png binary
*.jpg binary
*.xlsx binary
*.docx binary

# Файл блокировок показывать в сравнениях свёрнутым: он генерируется.
uv.lock linguist-generated=true -diff
