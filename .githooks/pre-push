#!/bin/sh
# Проверяем новые коммиты, а не только последнюю версию рабочего дерева.
set -eu
root=$(git rev-parse --show-toplevel)
remote_name=${1:?remote name required}
zero=0000000000000000000000000000000000000000
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" != "$zero" ] || continue
  case "$local_ref" in
    refs/heads/local/*)
      printf 'pre-push: локальная история не публикуется: %s\n' "$local_ref" >&2
      exit 1
      ;;
  esac
  commits=$(git rev-list "$local_sha" --not --remotes="$remote_name")
  for commit in $commits; do
    "$root/.githooks/privacy-check" commit "$commit"
  done
done
