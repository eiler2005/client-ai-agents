{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Рубрика оценки",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "updated", "scale", "verdicts", "groups", "dimensions"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "updated": { "type": "string", "format": "date" },
    "scale": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["level", "id", "name", "description"],
        "properties": {
          "level": { "type": "integer", "minimum": 0 },
          "id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "confidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "description"],
        "properties": {
          "id": { "enum": ["high", "medium", "low"] },
          "name": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "verdicts": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "min_score", "description"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "min_score": { "type": "number", "minimum": 0, "maximum": 100 },
          "description": { "type": "string" }
        }
      }
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "question"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "question": { "type": "string" }
        }
      }
    },
    "patterns": { "$ref": "#/$defs/catalogue" },
    "stages": { "$ref": "#/$defs/catalogue" },
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "group", "weight", "name", "question", "anchors", "criteria"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "group": { "type": "string" },
          "weight": { "type": "number", "exclusiveMinimum": 0 },
          "blocking": { "type": "boolean" },
          "name": { "type": "string" },
          "short": { "type": "string", "maxLength": 16 },
          "question": { "type": "string" },
          "anchors": {
            "type": "object",
            "propertyNames": { "pattern": "^[0-9]$" },
            "additionalProperties": { "type": "string" },
            "minProperties": 2
          },
          "criteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "name", "probe", "evidence"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
                "name": { "type": "string" },
                "probe": { "type": "string" },
                "evidence": { "type": "string" }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "catalogue": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "description"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    }
  }
}
